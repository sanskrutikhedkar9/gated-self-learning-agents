{
  "name": "appworld-continual-v1",
  "train_splits": ["train"],
  "dev_splits": ["dev"],
  "test_splits": ["test_normal", "test_challenge"],
  "learn_on_train": true,
  "calibrate_on_dev": true,
  "freeze_before_test": true,
  "fresh_world_fallback": true,
  "supported_step_kinds": [
    "tool",
    "compute",
    "paginate",
    "foreach",
    "filter",
    "reduce",
    "branch"
  ],
  "metadata": {
    "promotion_config": {
      "min_pattern_observations": 3,
      "min_shadow_executions": 3,
      "min_success_rate": 0.9,
      "min_wilson_lower_bound": 0.4,
      "quarantine_after_consecutive_failures": 2
    },
    "phase_policy": {
      "train": "compile workflows and update reliability",
      "dev": "freeze programs; update routing reliability only",
      "test": "read-only workflows; evaluator outcomes never update memory"
    },
    "test_routing_statuses": ["active"],
    "test_evaluator_feedback_updates_memory": false,
    "test_execution_updates_reliability": false,
    "automatic_confirmation": "exact workflow version and extracted variables only",
    "primary_metrics": [
      "task_goal_completion",
      "scenario_goal_completion",
      "model_input_tokens",
      "model_output_tokens",
      "full_agent_avoidance",
      "workflow_abstention",
      "fallback_rate"
    ]
  }
}
